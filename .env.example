# Copy to .env and adjust. Paths should point at a disk with ~60 GB free.
DATA_DIR=D:/AI/pcam
EMB_DIR=D:/AI/pcam/embeddings
CKPT_DIR=D:/AI/pcam/checkpoints
# Hub cache only (not HF_HOME): keeps the login token in its default location,
# which licence-accepted models (Hibou-L, Virchow, ...) need for download.
HF_HUB_CACHE=D:/AI/hf_cache/hub
RESULTS_DIR=results
LOG_DIR=logs
# Hugging Face repo that receives licence-clean heads/adapters (one collection for this research)
HF_REPO_ID=BurnyCoder/pcam-hibou-hillclimb
